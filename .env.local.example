# .env.local.example
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Sentry Error Tracking (for production)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Optional: Google Analytics (for production)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Rate Limiting & Caching (requires Redis - a redis:// connection
# string, not a REST API URL; falls back to in-memory if unset)
# REDIS_URL=redis://default:password@host:port
GEMINI_API_KEY=your_api_key_here
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,user@example.com
