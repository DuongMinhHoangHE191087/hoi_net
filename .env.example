# =============================================
# PHOTO RESTORATION AI - Environment Variables
# =============================================
# Copy file này thành .env.local và điền các giá trị thực

# =============================================
# SUPABASE CONFIGURATION (Required)
# =============================================
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================
# SUPABASE REALTIME (Required for Request Progress Tracking)
# =============================================
# Enable realtime for these tables in Supabase Dashboard:
# - user_requests (for request status updates)
# - notifications (for instant notifications)
# Go to: Database → Replication → Enable for tables above

# =============================================
# CLOUDINARY CONFIGURATION (Required for Image Upload)
# =============================================
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================
# ADMIN CONFIGURATION (Required)
# =============================================
# Comma-separated list of admin emails
# These admins will receive notifications when new requests are created
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,another-admin@example.com

# =============================================
# AI CONFIGURATION (Required for AI Features)
# =============================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# AI Processing Configuration
NEXT_PUBLIC_AI_MONTHLY_QUOTA=5
NEXT_PUBLIC_AI_DEFAULT_MODEL=gemini-2.5-flash

# =============================================
# COOKIE & SECURITY (Required - Generate These!)
# =============================================
# Generate with: npm run generate:secrets
# Or manually: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-this-to-a-random-64-char-hex-string
CSRF_SECRET=change-this-to-another-random-64-char-hex-string

# Optional: Session encryption (if using custom session management)
SESSION_SECRET=another-random-secret-for-sessions

# =============================================
# NEXTAUTH CONFIGURATION
# =============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================
# GOOGLE OAUTH (Optional - for Google Sign In)
# =============================================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================
# RATE LIMITING (Optional - Requires Upstash Redis)
# =============================================
# Get from: https://upstash.com/
# Leave empty to disable rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================
# ERROR TRACKING (Optional - Sentry)
# =============================================
# Get from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=

# =============================================
# ANALYTICS (Optional)
# =============================================
# Google Analytics
NEXT_PUBLIC_GA_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# =============================================
# APPLICATION SETTINGS
# =============================================
# Environment
NODE_ENV=development

# =============================================
# EMAIL CONFIGURATION (Optional)
# =============================================
# For sending emails (if implementing email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# =============================================
# PAYMENT GATEWAY (Optional - Future)
# =============================================
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# =============================================
# STORAGE (Optional - Alternative to Cloudinary)
# =============================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# =============================================
# SOCIAL AUTH (Optional - Future)
# =============================================
# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================
# WEBHOOK SECRETS (Optional)
# =============================================
# Supabase Webhook Secret (for DB webhooks)
SUPABASE_WEBHOOK_SECRET=

# Cloudinary Webhook Secret
CLOUDINARY_WEBHOOK_SECRET=

# =============================================
# FEATURE FLAGS (Optional)
# =============================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_AI_PROCESSING=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_FEEDBACK=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_RATE_LIMITING=false

# =============================================
# DEVELOPMENT TOOLS (Optional)
# =============================================
# Enable dev tools
NEXT_PUBLIC_ENABLE_DEVTOOLS=false

# Debug mode
DEBUG=false

# =============================================
# SETUP INSTRUCTIONS
# =============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in required values (marked as Required above)
# 3. Generate secrets: npm run generate:secrets
# 4. Start server: npm run dev
#
# SECURITY NOTES:
# - NEVER commit .env.local to Git
# - Generate unique secrets for COOKIE_SECRET and CSRF_SECRET
# - Use different values for development and production
# - Rotate secrets regularly (every 3-6 months)
# - Keep this file updated when adding new env vars
